# ==============================================================================
# Joomha Education — Environment Configuration Template
# ==============================================================================
# Salin file ini menjadi .env.local untuk development lokal:
#   cp .env.example .env.local
# JANGAN PERNAH memasukkan rahasia/secret atau production credentials ke file ini.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Joomha Education"
NEXT_PUBLIC_APP_TAGLINE="Digital Learning & Business Solutions"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/joomha_education?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Auth.js) - Dimiliki Agent 02
# ------------------------------------------------------------------------------
# Jalankan `openssl rand -base64 33` atau `npx auth secret` untuk membuat secret baru.
AUTH_SECRET="development-insecure-secret-replace-with-openssl-rand-base64-33"
AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. AI & OPENROUTER (Dimiliki Agent 08)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_MODEL="google/gemini-2.0-flash-001"
OPENROUTER_EMBEDDING_MODEL="text-embedding-3-small"

# ------------------------------------------------------------------------------
# 5. STORAGE & FILE UPLOADS (Dimiliki Agent 09)
# ------------------------------------------------------------------------------
# Driver: "local" untuk development lokal, "s3" untuk cloud object storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./public/uploads"
# Konfigurasi S3 (opsional di dev)
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION="auto"
STORAGE_S3_BUCKET=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (Dimiliki Agent 04)
# ------------------------------------------------------------------------------
# Mock mode diaktifkan di development agar tidak membutuhkan uang sungguhan
PAYMENT_MOCK_ENABLED="true"
PAYMENT_PROVIDER="mock"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 7. EMAIL & NOTIFIKASI (Dimiliki Agent 09)
# ------------------------------------------------------------------------------
# Driver: "console" untuk logging di terminal, "smtp" untuk server email nyata
MAIL_DRIVER="console"
MAIL_HOST="localhost"
MAIL_PORT="1025"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="no-reply@edu.joomha.dev"
MAIL_FROM_NAME="Joomha Education"

