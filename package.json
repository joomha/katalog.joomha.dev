{
  "name": "joomha-education",
  "version": "0.1.0",
  "private": true,
  "description": "Joomha Education — Digital Learning & Business Solutions Platform",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema=prisma --allow-no-models",
    "db:migrate:dev": "prisma migrate dev --schema=prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma",
    "db:seed": "node -e \"console.log('Seed runner will be orchestrated by Agent 10')\"",
    "identity:create-superadmin": "node src/modules/identity/cli/create-superadmin.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.475.0",
    "next": "15.2.1",
    "next-auth": "5.0.0-beta.32",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.0.2",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.50.1",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.21.0",
    "eslint-config-next": "15.2.1",
    "jsdom": "26.0.0",
    "postcss": "8.5.3",
    "prisma": "6.4.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  }
}
